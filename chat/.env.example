# Copy this file to `.env` and fill in both values.
#
#   cp .env.example .env
#
# Both are copied from the ZooClaw workspace UI. Never commit `.env`.

# Your organization's API key (`zct_…`), issued by your org admin.
#
# SECURITY: this authenticates your WHOLE ORGANIZATION — anyone holding it can read,
# modify, start, stop and delete every agent in your org, and read every session under
# them. There is no per-user or read-only variant. It stays in this server process and
# never reaches the browser. That is the only reason this template has a server at all.
ZOOCLAW_API_KEY=

# The agent you want to talk to (`agt_…`).
# Copy it from the agent's detail dialog in the workspace UI.
ZOOCLAW_AGENT_ID=

# Optional: where the server listens. Default 3000.
# PORT=3000
