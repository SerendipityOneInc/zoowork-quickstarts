{
  "name": "zooclaw-app-kit",
  "version": "0.1.0",
  "description": "zooclaw-app-kit \u2014 a reusable, business-free host-side template for agent-native apps on Zooclaw the ZooClaw API (Cloudflare Workers + D1 + Durable Objects). Fill domain/, ship.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts server/*.test.ts server/zooclaw/*.test.ts worker/*.test.ts domain/*.test.ts",
    "build": "vite build",
    "dev": "concurrently -n vite,worker -c blue,green \"vite\" \"pnpm dev:worker\"",
    "dev:worker": "wrangler dev --port ${KIT_WORKER_PORT:-8787}",
    "db:migrate:local": "wrangler d1 migrations apply zooclaw-app-kit --local",
    "db:migrate": "wrangler d1 migrations apply zooclaw-app-kit --remote"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@zooclaw-agents/sdk": "^0.0.3",
    "hono": "^4.12.10",
    "jose": "^6.2.3",
    "jotai": "^2.20.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250603.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.20.0"
  }
}
