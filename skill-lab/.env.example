# Copy this file to `.env` and fill in the one blank.
#
#   cp .env.example .env
#
# Unlike `chat/`, this template BUILDS its own agent — that is the point — so it needs
# only the key. Never commit `.env`.

# Your organization's API key (`zct_…`), issued by your org admin.
#
# SECURITY: this authenticates your WHOLE ORGANIZATION. Anyone holding it can read,
# modify and delete every agent in your org. It stays in this server process and never
# reaches the browser.
ZOOCLAW_API_KEY=

# Optional: point the lab at an agent you already own instead of building one.
# Leave it blank and the lab creates `skill-lab` on first run and remembers it in `.agent`.
# ZOOCLAW_AGENT_ID=

# Optional: where the server listens. Default 3000.
# PORT=3000
